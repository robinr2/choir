#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"
gitleaks git --staged --no-banner --redact
cd apps/core
npx prettier --check "src/**/*.ts" "test/**/*.ts"
npm run --silent lint
npx knip
npx jscpd
npx depcruise src test
npx depcruise src test --config .dependency-cruiser-stability.cjs
npx tsc --noEmit -p tsconfig.json
npm run --silent test:cov
npx nestjs-doctor . --staged --blocking error
npx stryker run
cd ../web
npx prettier --check "src/**/*.{ts,tsx}"
npm run --silent lint
npx knip
npx jscpd
npx depcruise src
npx depcruise src --config .dependency-cruiser-stability.cjs
npx tsc -b --noEmit
npx react-doctor . --staged --no-score --no-supply-chain --blocking warning
npm run --silent test:cov
npx stryker run
cd ../voice
uv run --frozen ruff format --check
uv run --frozen ruff check
./check-max-lines.sh
uv run --frozen pyright
uv run --frozen pytest
uv run --frozen vulture src tests
uv run --frozen deptry src
./check-mutants.sh
../core/node_modules/.bin/jscpd
