{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl --silent --fail --max-time 10 --header 'Content-Type: application/json' --data-binary @- \"$CHOIR_CORE_URL/conversations/$CHOIR_CONVERSATION_ID/prompt-contexts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl --silent --fail --max-time 600 --header 'Content-Type: application/json' --data-binary @- \"$CHOIR_CORE_URL/conversations/$CHOIR_CONVERSATION_ID/tool-calls\" || exit 2",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
