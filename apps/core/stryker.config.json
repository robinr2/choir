{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": ["src/**/*.ts", "!src/**/*.spec.ts", "!src/main.ts"],
  "incremental": true,
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  }
}
