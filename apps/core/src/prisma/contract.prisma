// use prisma-8
model Notification {
  id          Uuid               @id @default(uuid())
  source      String
  eventId     String
  title       String
  text        String
  link        String?
  sentAt      Timestamptz
  receivedAt  Timestamptz        @default(now())
  archivedAt  Timestamptz?
  position    Float
  attachments Attachment[]
  todos       TodoNotification[]
  queueItem   QueueItem?

  @@unique([source, eventId])
}

model Attachment {
  id             Uuid         @id @default(uuid())
  notificationId Uuid
  notification   Notification @relation(fields:[notificationId], references:[id])
  index          Int
  filename       String
  mediaType      String
  content        Bytes

  @@unique([notificationId, index])
}

model Todo {
  id            Uuid               @id @default(uuid())
  title         String
  description   String
  dueAt         Timestamptz?
  createdAt     Timestamptz        @default(now())
  updatedAt     Timestamptz        @default(now())
  archivedAt    Timestamptz?
  position      Float
  notifications TodoNotification[]
}

model TodoNotification {
  todoId         Uuid
  todo           Todo         @relation(fields:[todoId], references:[id])
  notificationId Uuid
  notification   Notification @relation(fields:[notificationId], references:[id])
  linkedAt       Timestamptz  @default(now())

  @@id([todoId, notificationId])
  @@index([notificationId])
}

model QueueItem {
  notificationId Uuid         @id
  notification   Notification @relation(fields:[notificationId], references:[id])
  attempts       Int          @default(0)
  dueAt          Timestamptz  @default(now())
  lastError      String?
  doneAt         Timestamptz?

  @@index([dueAt])
}

enum PaneKind {
  @@type("pg/text@1")
  empty = "empty"
  agent = "agent"
  excalidraw = "excalidraw"
}

model LayoutState {
  id              Int @id
  activeWorkspace Int
  nextNumber      Int
}

model Workspace {
  id               Uuid           @id
  position         Int
  activeColumn     Int
  restoresPrevious Boolean
  columns          LayoutColumn[]
}

model LayoutColumn {
  id          Uuid      @id
  workspaceId Uuid
  workspace   Workspace @relation(fields:[workspaceId], references:[id], onDelete: Cascade)
  position    Int
  width       Float
  fullWidth   Boolean
  activeTile  Int
  panes       Pane[]

  @@index([workspaceId])
}

model Pane {
  id          Uuid         @id
  columnId    Uuid
  column      LayoutColumn @relation(fields:[columnId], references:[id], onDelete: Cascade)
  position    Int
  kind        PaneKind
  name        String?
  autoHeight  Float?
  fixedHeight Float?

  @@index([columnId])
}

model AgentSession {
  conversationId Uuid   @id
  sessionId      String
}
