{
  "mcpServers": {
    "jscpd": {
      "command": "npx",
      "args": [
        "--prefix",
        "apps/core",
        "jscpd",
        "--mcp",
        "--format",
        "typescript,tsx",
        "--ignore",
        "**/apps/web/src/components/ui/**,**/apps/web/src/components/assistant-ui/**,**/apps/web/src/hooks/use-attachment-src.ts,**/apps/web/src/hooks/use-copy-to-clipboard.ts,**/apps/web/src/components/pipecat/**,**/apps/web/src/lib/visualizer.ts",
        "apps/core/src",
        "apps/core/test",
        "apps/web/src"
      ]
    },
    "shadcn": {
      "command": "sh",
      "args": ["-c", "cd apps/web && exec npx shadcn mcp"]
    },
    "pipecat-context-hub": {
      "command": "uvx",
      "args": ["pipecat-ai-context-hub@0.8.0", "serve"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@0.0.82"]
    }
  }
}
