{
  "mcpServers": {
    "jscpd": {
      "command": "npx",
      "args": [
        "--prefix",
        "server",
        "jscpd",
        "--mcp",
        "--format",
        "typescript,tsx",
        "--ignore",
        "**/web/src/components/ui/**,**/web/src/components/assistant-ui/**,**/web/src/hooks/use-attachment-src.ts,**/web/src/hooks/use-copy-to-clipboard.ts",
        "server/src",
        "server/test",
        "web/src"
      ]
    },
    "shadcn": {
      "command": "sh",
      "args": ["-c", "cd web && exec npx shadcn mcp"]
    }
  }
}
